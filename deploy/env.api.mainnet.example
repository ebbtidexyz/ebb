# Ebb API — Robinhood Chain MAINNET (4663), Pons v2 vault. Copy to /opt/ebb/.env.api on the VPS (chmod 600, owner ebb).
# systemd EnvironmentFile: no inline comments, no quotes needed; keep comments on their own lines.
# The chain-derived block below can be generated after DeployMainnet.s.sol --broadcast:
#   cd services/api && npx tsx scripts/mainnet-env-from-deployment.ts   (reads contracts/deployments/4663.json)
# See services/api/README.md "Mainnet (Pons v2)" for the cutover steps.

# --- process -----------------------------------------------------------------------------------------------------
EBB_MODE=chain
PORT=8790
HOST=127.0.0.1
# NEW database: never reuse the testnet sqlite (tides, grants and cursors are chain-specific)
DB_PATH=./data/ebb-mainnet.sqlite
# openssl rand -hex 32 (>= 32 chars; rotating it logs everyone out)
SESSION_SECRET=
WEB_ORIGIN=https://ebbtide.xyz
SIWE_DOMAIN=ebbtide.xyz
UPSTREAMS_JSON=./upstreams.json
LOG_LEVEL=info

# --- chain -------------------------------------------------------------------------------------------------------
CHAIN_ID=4663
# Official RPC: reachable directly from the VPS (blocked by the ISP on the dev laptop). It serves eth_getLogs back to
# DEPLOY_BLOCK, which the indexer and the fee-recipient monitor need. publicnode (https://robinhood-rpc.publicnode.com)
# works for live reads but refuses getLogs older than ~1 day without a token.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# deployments/4663.json .vault
VAULT_ADDRESS=
# deployments/4663.json .token (predicted; has code from launch on)
TOKEN_ADDRESS=
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# deployments/4663.json .deployBlock (L2 block)
DEPLOY_BLOCK=

# --- keys (hex, 0x + 64) -----------------------------------------------------------------------------------------
# MUST be the vault's operator (commitGrants, withdrawForUsage). Unset = fail closed
OPERATOR_PRIVATE_KEY=
# any EOA with a little ETH (poke ~560 tx/day, harvest 48/day, burns). Unset = keeper idle
KEEPER_PRIVATE_KEY=

# --- Pons v2 -----------------------------------------------------------------------------------------------------
# auto|true|false. auto = vault has quote()/feeCurve() and a non-zero curve
PONS_MODE=true
# deployments/4663.json .pokeTwap (if unset: read from vault.oracle().tokenTwap())
POKE_TWAP_ADDRESS=
# PokeTwapOracle accepts one sample per 150 s; it needs 30 min of history before burns work
POKE_INTERVAL_MS=155000
# harvest() once per tide at :05 / :35 UTC
HARVEST_OFFSET_S=300
# watched for CreatorFeeRecipientChangeProposed
PONS_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
MONITOR_INTERVAL_MS=60000
MONITOR_BATCH_BLOCKS=50000

# --- burns -------------------------------------------------------------------------------------------------------
# $50 per burnExpired call (small slices keep curve/pool sandwiches unprofitable)
BURN_SLICE_MICRO=50000000
# per tide per keeper round; a reverting slice ends that tide until the next round
BURN_MAX_SLICES=10
KEEPER_INTERVAL_MS=600000

# --- grant exclusions --------------------------------------------------------------------------------------------
# The allocator must NEVER grant to contracts that hold $EBB for the market: before graduation the CURVE holds the whole
# unsold supply (it would take nearly every grant), after graduation the Uniswap v4 POOLMANAGER holds the pool's $EBB.
# In Pons mode the API already adds vault/token/usdg/treasury/settlement, the curve, hook, escrow, swap adapter, oracle,
# poke TWAP, factory, PoolManager, pons locker and buyback vault, 0x0 and 0x…dEaD. List them here anyway (auditable),
# plus any other contract or team wallet that should not receive grants (CEX/bridge wallets once known).
# Do NOT exclude the dev-buy recipient unless you want it to receive nothing.
#   vault, launcher, curve, swapAdapter        from deployments/4663.json
#   v4 PoolManager                             0x8366a39CC670B4001A1121B8F6A443A643e40951
#   pons LP locker                             0x267444D099b10fB5Ed7c3Cc7B7c767AdcA574952
#   pons buyback vault                         0x42df2a798f82289E177311362e8f5ccC45c1219c
#   pons hook / fee escrow / factory           0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044 / 0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e / 0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
#   dead / zero                                0x000000000000000000000000000000000000dEaD / 0x0000000000000000000000000000000000000000
EXCLUDED_ADDRESSES=<vault>,<launcher>,<curve>,<swapAdapter>,0x8366a39CC670B4001A1121B8F6A443A643e40951,0x267444D099b10fB5Ed7c3Cc7B7c767AdcA574952,0x42df2a798f82289E177311362e8f5ccC45c1219c,0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044,0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e,0x000000000000000000000000000000000000dEaD,0x0000000000000000000000000000000000000000

# --- other tuning (defaults shown) -------------------------------------------------------------------------------
INDEXER_INTERVAL_MS=5000
INDEXER_BATCH_BLOCKS=2000
INDEXER_LAG_BLOCKS=3
ALLOCATOR_DELAY_S=60
SETTLEMENT_INTERVAL_MS=3600000
PUBLISHER_INTERVAL_MS=30000
DEFAULT_MAX_TOKENS=1024
# KEEPER_HARVEST_MIN_WEI is ignored in Pons mode (legacy/testnet vaults only)
