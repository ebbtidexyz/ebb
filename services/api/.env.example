# Copy to .env (not committed) or set in the systemd unit. Everything is optional in sandbox.
EBB_MODE=sandbox            # sandbox | chain  (default: chain when VAULT_ADDRESS is set, else sandbox)
PORT=8787
# HOST=127.0.0.1            # bind address; set on the VPS behind nginx
DB_PATH=./data/ebb.sqlite
UPSTREAMS_JSON=./upstreams.json
WEB_ORIGIN=http://localhost:3000
SIWE_DOMAIN=localhost:3000
# SESSION_SECRET=           # required in chain mode, >= 32 chars (openssl rand -hex 32)

# chain mode
RPC_URL=https://robinhood-sepolia-rpc.publicnode.com
CHAIN_ID=46630
# VAULT_ADDRESS=
# TOKEN_ADDRESS=
# USDG_ADDRESS=             # default: vault.usdg()
# DEPLOY_BLOCK=             # token deploy block, indexer start
# OPERATOR_PRIVATE_KEY=     # commitGrants + withdrawForUsage
# KEEPER_PRIVATE_KEY=       # harvest + burnExpired (gas only)
# EXCLUDED_ADDRESSES=0x..,0x..
# OPENROUTER_API_KEY=       # referenced by upstreams.json api_key_env
