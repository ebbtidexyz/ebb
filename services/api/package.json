    "@hono/node-server": "^2.1.3",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "hono": "^4.13.12",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
